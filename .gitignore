# ============================================================
# QG 抢购项目 .gitignore
# 结构口径：core / platforms / web / tools / verify / docs（2026-10-08 重组后）
# ============================================================

# ── 依赖（体积大、可重装）──
node_modules/

# ── 旧平台归档（冻结快照，体积大，不入库）──
归档_旧抢购平台_2026-10-08/

# ── 本机工具：Android platform-tools（adb / fastboot，本地工具、体积大，不入库）──
platform-tools/

# ── data/grab：配置类入库；运行时状态排除 ──
data/grab/chrome-profile-rush/
data/grab/selftest-profile/
data/grab/evidence/
*.pid
data/grab/*.log
data/grab/*.results.jsonl
data/grab/*-schedule.json
data/grab/*.bak-*
data/grab/auto-dispatch-log.md
# 说明：checkup-history.jsonl 有意入库（低频率的体检证据流水）
# ── 个人实名信息文件（不入库；各机本地保留，含姓名/电话/证件/地址）──
damai.config.json
data/grab/damai.config.json
data/grab/account.profile.json

# ── 验证区（verify/）：临时目录与产物排除 ──
verify/tmp/
verify/output/
verify/evidence/
verify/node_modules/

# ── 快照 / 编辑器 / 工具运行态 ──
.snapshots/
.zcode/
.gstack/

# ── 系统噪音 ──
Thumbs.db
desktop.ini
.DS_Store
data/grab/device-events.jsonl
data/grab/diag/

# ── Python 产物 ──
__pycache__/
*.pyc
