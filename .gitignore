# ============================================================
# QG 抢购项目 .gitignore
# （baseline 版：重组前路径口径；重组提交里会更新为新路径）
# ============================================================

# ── 依赖（体积大、可重装）──
node_modules/

# ── 旧平台归档（冻结快照，体积大，不入库）──
归档_旧抢购平台_2026-10-08/

# ── data/grab：配置类入库；运行时状态排除 ──
data/grab/chrome-profile-rush/
data/grab/selftest-profile/
data/grab/evidence/
*.pid
data/grab/*.log
data/grab/*.results.jsonl
data/grab/*.history.jsonl
data/grab/*-schedule.json
data/grab/*.bak-*

# ── 验证区（grab-probe）临时产物 ──
grab-probe/.probe-work/
grab-probe/chrome-profile/
grab-probe/.probe-tmp*/
grab-probe/output/
grab-probe/evidence/
grab-probe/node_modules/

# ── 快照 / 编辑器 / 工具运行态 ──
.snapshots/
.zcode/
.gstack/

# ── 系统噪音 ──
Thumbs.db
desktop.ini
.DS_Store
