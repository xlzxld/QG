# ============================================================
# QG 抢购项目 .gitignore
# 结构口径：core / platforms / web / tools / verify / docs（2026-10-08 重组后）
# ============================================================

# ── 依赖（体积大、可重装）──
node_modules/

# ── 旧平台归档（冻结快照，体积大，不入库）──
归档_旧抢购平台_2026-10-08/

# ── data/grab：配置类入库；运行时状态排除 ──
data/grab/chrome-profile-rush/
data/grab/selftest-profile/
data/grab/evidence/
*.pid
data/grab/*.log
data/grab/*.results.jsonl
data/grab/*-schedule.json
data/grab/*.bak-*
# 说明：checkup-history.jsonl 有意入库（低频率的体检证据流水）

# ── 验证区（verify/）：临时目录与产物排除 ──
verify/tmp/
verify/output/
verify/evidence/
verify/node_modules/

# ── 快照 / 编辑器 / 工具运行态 ──
.snapshots/
.zcode/
.gstack/

# ── 系统噪音 ──
Thumbs.db
desktop.ini
.DS_Store
