{
  "name": "flash-sale-system",
  "version": "8.0.0",
  "description": "稀缺名额与稀缺商品抢购平台",
  "type": "module",
  "scripts": {
    "build": "tsc && node -e \"import('node:fs').then(fs => fs.copyFileSync('src/db/schema.sql', 'dist/db/schema.sql'))\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node --loader tsx src/db/migrate.ts",
    "start": "node dist/server/index.js",
    "start:dev": "tsx src/server/index.ts",
    "rush:huawei": "tsx scripts/huawei-rush.ts status",
    "rush:login": "tsx scripts/huawei-rush.ts login",
    "rush:test": "tsx scripts/huawei-rush.ts test-rush",
    "rush:live": "tsx scripts/huawei-rush.ts live"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "dotenv": "^16.4.7",
    "hono": "^4.7.2",
    "pg": "^8.13.3",
    "playwright": "^1.50.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.16",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
